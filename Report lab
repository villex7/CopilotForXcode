# Register custom fonts if available, else use standard fonts
def register_fonts():
    try:
        pdfmetrics.registerFont(TTFont('SweetPoppy', 'Sweet_Poppy.ttf'))
        pdfmetrics.registerFont(TTFont('CandyBeans', 'Candy_Beans.otf'))
        return 'SweetPoppy', 'CandyBeans'
    except Exception as e:
        print(f"Custom fonts not loaded ({e}), using Helvetica fallback.")
        # No need to register Helvetica, use default names
        return 'Helvetica-Bold', 'Helvetica'

font_header, font_body = register_fonts()

