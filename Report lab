# Custom DocTemplate to paint pastel pink background on every page
class PastelPinkTemplate(SimpleDocTemplate):
    def __init__(self, filename, **kw):
        super().__init__(filename, **kw)
        self.pastel_pink = colors.HexColor("#FFD1DC")

    def beforePage(self):
        self.canv.saveState()
        self.canv.setFillColor(self.pastel_pink)
        self.canv.rect(0, 0, self.pagesize[0], self.pagesize[1], fill=1, stroke=0)
        self.canv.restoreState()

